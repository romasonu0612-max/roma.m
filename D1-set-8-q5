// 2. Retrieve transactions for a specific user (userId = 1)
print("Transactions for User 1:");
db.transactions.find({ userId: 1 })
  .forEach(doc => printjson(doc));

// 3. Filter transactions with amount greater than a threshold (e.g., > 10000)
print("\nTransactions with amount > 10000:");
db.transactions.find({ amount: { $gt: 10000 } })
  .forEach(doc => printjson(doc));

// 4. Create indexes on userId and amount
db.transactions.createIndex({ userId: 1 });   // Ascending index
db.transactions.createIndex({ amount: 1 });   // Ascending index

print("\nIndexes created on userId and amount");

// 5. Use explain() to analyze query performance
print("\nExplain Plan for userId query:");
printjson(
  db.transactions.find({ userId: 1 }).explain("executionStats")
);

print("\nExplain Plan for amount query:");
printjson(
  db.transactions.find({ amount: { $gt: 10000 } }).explain("executionStats")
);
